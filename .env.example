# Local-only example. `pnpm bootstrap` creates an ignored .env with a random
# PostgreSQL password. Configure the matching local role before migrations.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WEB_HOST=127.0.0.1
WEB_PORT=3000
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=4010
POSTGRES_USER=community
POSTGRES_DB=community
POSTGRES_PASSWORD=replace-for-local-development
DATABASE_URL=postgresql://community:replace-for-local-development@127.0.0.1:5432/community?schema=public
REDIS_URL=redis://127.0.0.1:6379
API_BASE_URL=http://127.0.0.1:4000
